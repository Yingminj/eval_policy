 #: ``send_next_action_chunk``'s fixed bridge length.  Not configurable there either.
 DEPLOY_BRIDGE_STEPS = 40
 
+#: FORK (EEF): which action dimensions deploy treats as "arm" and which as grippers.
+#: ``send_next_action_chunk`` builds ``arm_joint_keys = [k for k in ordered_keys if
+#: "gripper" not in k.lower()][:14]`` and bridges ``min(14, len(arm_joint_keys))`` of them;
+#: the driver clips the gripper columns.  In 16-D joint space that is 14 arms + columns
+#: 14/15, which is what the unforked harness hardcodes.  In the 14-D EEF space it is
+#: **12** pose dims + columns **12/13** -- so the unforked constants bridge the two gripper
+#: channels deploy never bridges, and clip nothing.  Set from the dataset's action names.
+ACTION_LAYOUT = {"n_bridge": 14, "grippers": (14, 15)}
+
+
+def set_action_layout(names: list[str]) -> dict:
+    """Deploy's own rule, applied to this dataset's action names."""
+    grippers = tuple(i for i, n in enumerate(names) if "gripper" in n.lower())
+    arm = [i for i, n in enumerate(names) if "gripper" not in n.lower()][:14]
+    ACTION_LAYOUT.update(n_bridge=len(arm), grippers=grippers)
+    return dict(ACTION_LAYOUT)
+
 
